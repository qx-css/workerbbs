{
  "name": "workerbbs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A forum / community platform built on Cloudflare Workers + D1 (CloudWorker)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply:local": "wrangler d1 migrations apply workerbbs --local",
    "db:apply:remote": "wrangler d1 migrations apply workerbbs --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.87.0"
  }
}
